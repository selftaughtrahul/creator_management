# Copy this file to .env and fill in the keys you have.
# The app runs without them: email signup works locally, and each
# network can load labeled sample data until live keys are added.

SECRET_KEY=change-me
DEBUG=1

# Google sign-in (Cloud Console → OAuth client, Web application)
# Authorized redirect URI:
#   http://127.0.0.1:8000/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# YouTube connect. Leave blank to reuse the Google client above.
# Also enable YouTube Data API v3 and YouTube Analytics API.
# Authorized redirect URI:
#   http://127.0.0.1:8000/connections/youtube/callback/
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Facebook and Instagram share one Meta app.
# Add the Facebook Login product. Instagram must be a professional
# account linked to a Facebook Page you manage.
# Valid OAuth redirect URIs:
#   http://127.0.0.1:8000/connections/facebook/callback/
#   http://127.0.0.1:8000/connections/instagram/callback/
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0

# LinkedIn sign-in product, OpenID scopes (openid, profile, email).
# Authorized redirect URI:
#   http://127.0.0.1:8000/connections/linkedin/callback/
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Optional SMTP. While DEBUG=1 and EMAIL_HOST is empty, verification
# links are shown on the "check your email" page.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Awisee <noreply@localhost>
