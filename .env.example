# Copy this file to .env and fill in the keys you have.
# The app runs without them: email signup works locally, and each
# network can load labeled sample data until live keys are added.

SECRET_KEY=change-me
DEBUG=1

# Google sign-in (Cloud Console → OAuth client, Web application)
# Authorized redirect URI:
#   http://127.0.0.1:8000/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# YouTube connect. Leave blank to reuse the Google client above.
# Enable YouTube Data API v3 and YouTube Analytics API.
# Authorized redirect URI:
#   http://127.0.0.1:8000/connections/youtube/callback/
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=
# Set to 1 to run a queued YouTube sync inside the web request. Leave 0 and
# run: .\.venv\Scripts\python manage.py process_youtube_jobs
YOUTUBE_SYNC_EAGER=0
YOUTUBE_MAX_VIDEOS=2000
YOUTUBE_INCREMENTAL_VIDEOS=100
YOUTUBE_COMMENT_LIMIT=100
YOUTUBE_COMMENT_VIDEO_LIMIT=15
YOUTUBE_FULL_COMMENT_VIDEO_LIMIT=40
YOUTUBE_TRANSCRIPT_VIDEO_LIMIT=10
YOUTUBE_FULL_TRANSCRIPT_VIDEO_LIMIT=20
YOUTUBE_ANALYTICS_DAYS=28
YOUTUBE_VIDEO_ANALYTICS_LIMIT=25
YOUTUBE_RETENTION_VIDEO_LIMIT=5
# Optional compliant transcript provider. Leave empty to use official captions only.
YOUTUBE_TRANSCRIPT_PROVIDER_URL=
YOUTUBE_TRANSCRIPT_PROVIDER_TOKEN=

# Facebook uses the Meta app and a Facebook Login for Business configuration.
# Include pages_show_list, pages_read_engagement, and pages_read_user_content.
# Valid OAuth redirect URI. Use the ngrok https URL when that is what Meta has saved.
#   https://your-subdomain.ngrok-free.dev/connections/facebook/callback/
FACEBOOK_REDIRECT_URI=
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
META_LOGIN_CONFIG_ID=

# Instagram Login uses the Instagram App ID from
# Instagram → API setup with Instagram login → Business login settings.
# Do not put the Facebook App ID here. That causes "Invalid platform app".
# The redirect must match the URI saved on that same page.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://localhost:8000/connections/instagram/callback/
# Add instagram_business_manage_insights and instagram_business_manage_comments
# on the Instagram login product, then reconnect so a full sync can read them.
# Set to 1 to run a queued Instagram sync inside the web request. Leave 0 and
# run: .\.venv\Scripts\python manage.py process_instagram_jobs
INSTAGRAM_SYNC_EAGER=0
INSTAGRAM_MAX_MEDIA=500
INSTAGRAM_INSIGHTS_DAYS=28

# X (Twitter) OAuth 2.0. App type: Web App, confidential client, Read permission.
# Callback URI:
#   http://127.0.0.1:8000/connections/twitter/callback/
# Also allow http://localhost:8000/connections/twitter/callback/ if you open the site that way.
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# Optional Claude for natural-language search and classification.
# Rules still run if this is empty. Never commit the live key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Enrichment job worker. Official APIs only sync connected accounts.
JOB_BATCH_SIZE=10
JOB_PLATFORM_DELAY_SECONDS=1

# Optional SMTP. While DEBUG=1 and EMAIL_HOST is empty, verification
# links are shown on the "check your email" page.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Awisee <noreply@localhost>
